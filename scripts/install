#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# multi_instance=false self-guard: I2P binds fixed peer ports + one router identity per machine;
# YunoHost 12.1 does not refuse a second copy on its own.
if [[ "$app" != "java_i2p" && -d /etc/yunohost/apps/java_i2p ]]; then
	ynh_die "Only one instance of this app is supported (already installed as 'java_i2p')."
fi

#=================================================
# CHECK THE INSTALL PATH
#=================================================

if [ "${path:-/}" != "/" ]; then
    ynh_die --message="The I2P console uses absolute URLs and only works at the root of a domain — pick a (sub)domain with path '/'."
fi

#=================================================
# SETUP DEFAULTS
#=================================================

jvm_xmx="${jvm_xmx:-768m}"

#=================================================
# I2P FROM ITS OFFICIAL DEBIAN REPOSITORY
# Get the key from the Ubuntu keyserver only: the project's own key URL is intermittently an HTML 404 and keys.openpgp.org serves a STALE pre-renewal revision (expired signing subkey).
ynh_script_progression "Installing i2p-router from the official I2P apt repository..."
ynh_apt_install_dependencies_from_extra_repository \
    --repo="http://deb.i2p.net/ stable main" \
    --package="i2p-router" \
    --key="http://keyserver.ubuntu.com/pks/lookup?op=get&search=0x67ECE5605BCF1346"

#=================================================
# SEED CONFIG
# router.updateDisabled: apt owns updates; the router must not overwrite dpkg-managed files over the network.
# router.floodfillParticipant: volunteering network capacity is the point of this package; toggle in Console -> Config -> Router manager.
# Seeding clients.config marks a provisioned install so the router won't copy distro default apps; it splits into clients.config.d/ during first boot.
#=================================================
ynh_script_progression "Seeding router config (peer port $port_ext, floodfill relay, console on $port)..."
cat > "$data_dir/router.config" <<EOF
router.updateDisabled=true
router.floodfillParticipant=true
i2np.ntcp.port=$port_ext
i2np.udp.port=$port_ext
i2np.udp.internalPort=$port_ext
EOF
cat > "$data_dir/clients.config" <<EOF
clientApp.0.args=$port 127.0.0.1 ./webapps/
clientApp.0.main=net.i2p.router.web.RouterConsoleRunner
clientApp.0.name=I2P Router Console
clientApp.0.startOnLoad=true
EOF
echo "routerconsole.welcomeWizardComplete=true" >> "$data_dir/router.config"
chown -R "$app:$app" "$data_dir"

#=================================================
# INSTALL AND START THE SYSTEMD SERVICE
#=================================================

ynh_script_progression "Configuring systemd service..."
ynh_config_add_systemd
yunohost service add "$app" --description="I2P router" --needs_exposed_ports "$port_ext"
ynh_systemctl --service="$app" --action=start --log_path=systemd --timeout=300

#=================================================
# FIRST BOOT MUST FINISH BEFORE ANY CONFIG EDIT.
# First boot splits clients.config into clients.config.d/ (that enables the console);
# hand-editing router.config mid-boot gets clobbered (or clobbers the seeding).
#=================================================
ynh_script_progression "Waiting for the router's first boot to complete..."
waited=0
while [ "$waited" -lt 300 ]; do
    if [ -d "$data_dir/clients.config.d" ] || curl -fsS -o /dev/null -m 3 "http://127.0.0.1:$port/"; then
        break
    fi
    sleep 5
    waited=$((waited + 5))
done
if [ "$waited" -ge 300 ]; then
    ynh_die --message="First boot did not complete within 300s (no clients.config.d in $data_dir). Check: journalctl -u $app"
fi
sleep 5

#=================================================
# CONFIGURE NGINX AND SSO LOGO
#=================================================

ynh_script_progression "Configuring nginx (SSO-gated router console)..."
ynh_config_add_nginx

# SSO portal tile logo (supported override for non-catalog apps)
if [ -f "$YNH_APP_BASEDIR/doc/i2p.png" ]; then
    cp "$YNH_APP_BASEDIR/doc/i2p.png" "/usr/share/yunohost/applogos/$app.png"
    yunohost user permission update "$app.main" --logo "/usr/share/yunohost/applogos/$app.png" || true
fi

#=================================================
# CONSOLE: allow the public hostname (Host-header check).
# Edit while the router is DOWN: it persists router.config on shutdown and would clobber a live edit.
#=================================================
ynh_script_progression "Allowing $domain in the router console's allowedHosts..."
ynh_app_setting_set --key=console_allowed_hosts --value="localhost,127.0.0.1,[::1],$domain"
systemctl stop "$app"
sed -i "s|^routerconsole.allowedHosts=.*|# removed|" "$data_dir/router.config"
echo "routerconsole.allowedHosts=localhost,127.0.0.1,[::1],$domain" >> "$data_dir/router.config"
chown "$app:$app" "$data_dir/router.config"

# SAM bridge on by default: distro ships SAMBridge registered but startOnLoad=false; downstream apps (qBittorrent etc.) expect SAM right after install.
# 7656 is the upstream default; if another router holds it, fall back to 7666. Loopback-only.
port_busy() { ss -ltn 2>/dev/null | grep -qE "[:.]$1([[:space:]]|\$)"; }
port_sam="${port_sam:-7656}"
if port_busy "$port_sam"; then
    if port_busy 7666; then
        ynh_die "Neither SAM port $port_sam nor the fallback 7666 is free. Stop the other router or choose another port."
    fi
    ynh_print_warn "SAM port $port_sam is already in use (another I2P router?); using 7666 for $app's SAM bridge."
    port_sam=7666
fi
ynh_app_setting_set --key=port_sam --value=$port_sam
ynh_script_progression "Enabling the SAM bridge (127.0.0.1:$port_sam)..."
sam_file="$data_dir/clients.config.d/01-net.i2p.sam.SAMBridge-clients.config"
if [ -f "$sam_file" ]; then
    sed -i "s|^clientApp.0.startOnLoad=.*|clientApp.0.startOnLoad=true|" "$sam_file"
else
    cat > "$sam_file" <<EOF
clientApp.0.args=sam.keys 127.0.0.1 $port_sam i2cp.tcp.host=127.0.0.1 i2cp.tcp.port=7654
clientApp.0.delay=120
clientApp.0.main=net.i2p.sam.SAMBridge
clientApp.0.name=SAM application bridge
clientApp.0.startOnLoad=true
EOF
fi
chown "$app:$app" "$sam_file"
systemctl restart "$app"

#=================================================
# WAIT FOR CONSOLE READINESS
#=================================================

# Jetty/console takes well over a minute after cold restart; poll so slow hardware doesn't get a false alarm.
ready=0
for i in $(seq 1 24); do
    if curl -fsS -o /dev/null -m 5 "http://127.0.0.1:$port/"; then
        ready=1
        break
    fi
    sleep 10
done
if [ "$ready" -eq 1 ]; then
    ynh_print_warn "Console: https://$domain$path (SSO-gated). Loopback: http://127.0.0.1:$port"
else
    ynh_print_warn "Console not answering after ~4 min — check: journalctl -u $app"
fi

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "IMPORTANT: forward TCP $port_ext AND UDP $port_ext on your router to this server's LAN address, or the router stays 'Firewalled' and relays almost nothing. Router data dir: $data_dir"
