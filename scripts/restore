#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

# Keep this path for calling _common.sh inside the execution's context of backup and restore scripts
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE SYSTEM CONFIGURATION
#=================================================

ynh_script_progression "Restoring systemd unit..."
ynh_safe_rm "/etc/systemd/system/$app.service"
ynh_restore "/etc/systemd/system/$app.service"
yunohost service add "$app" --description="I2P router" --needs_exposed_ports "$port_ext"

#=================================================
# RESTORE THE DATA DIRECTORY
#=================================================

ynh_restore "$data_dir"
chown -R "$app:$app" "$data_dir"

#=================================================
# INSTALL THE I2P PACKAGE IF MISSING
#=================================================

ynh_script_progression "Ensuring the i2p-router package is installed on this machine..."
# Restore onto a fresh machine has the data but not the dpkg payload.
if ! dpkg -s i2p-router >/dev/null 2>&1; then
    ynh_apt_install_dependencies_from_extra_repository \
        --repo="http://deb.i2p.net/ stable main" \
        --package="i2p-router" \
        --key="http://keyserver.ubuntu.com/pks/lookup?op=get&search=0x67ECE5605BCF1346" \
        || ynh_print_warn "Could not install i2p-router automatically; install it manually, then systemctl restart $app"
fi

#=================================================
# RELOAD NGINX AND PHP-FPM OR THE APP SERVICE
#=================================================

ynh_script_progression "Restarting I2P..."
systemctl daemon-reload
systemctl restart "$app" || true

#=================================================
# RE-RENDER THE NGINX CONFIG
#=================================================

# Nginx snippet is not part of the backup archive; re-render (vhost dir may not exist on a fresh machine).
domain=$(ynh_app_setting_get --key=domain || echo "")
if [ -n "${domain:-}" ] && [ -d "/etc/nginx/conf.d/$domain.d" ]; then
    ynh_config_add_nginx

#=================================================
# END OF SCRIPT
#=================================================

fi
